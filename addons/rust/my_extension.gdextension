[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64 = "res://addons/rust/target/debug/libmy_extension.so"
linux.release.x86_64 = "res://addons/rust/target/release/libmy_extension.so"
windows.debug.x86_64 = "res://addons/rust/target/debug/my_extension.dll"
windows.release.x86_64 = "res://addons/rust/target/release/my_extension.dll"
macos.debug.x86_64 = "res://addons/rust/target/debug/libmy_extension.dylib"
macos.release.x86_64 = "res://addons/rust/target/release/libmy_extension.dylib"
macos.debug.arm64 = "res://addons/rust/target/debug/libmy_extension.dylib"
macos.release.arm64 = "res://addons/rust/target/release/libmy_extension.dylib"
