; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AL67X"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneManager="*uid://j20v4cg7v8m1"
Firebase="*res://addons/GodotFirebaseAndroid/Firebase.gd"
EventBus="*res://src/autoload/event_bus.gd"
SaveService="*res://src/autoload/save_service.gd"
EconomyService="*res://src/autoload/economy_service.gd"
AmpsService="*res://src/autoload/amps_service.gd"
InputService="*res://src/autoload/input_service.gd"
AudioDirector="*res://src/autoload/audio_director.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotFirebaseAndroid/plugin.cfg", "res://addons/goutte.animated_shape_2d/plugin.cfg", "res://addons/scene_manager/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

